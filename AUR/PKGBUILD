# Maintainer: roma_ogon
pkgname=zapusk
pkgver=3.2.0
pkgrel=1
pkgdesc="Cyberpunk launcher for Windows games on Linux (Wine + DXVK + VKD3D)"
arch=('any')
url="https://github.com/romanepev2014-stack/zapusk"
license=('GPL-3.0-or-later')
depends=(
  'python'
  'pyside6'
  'wine-staging'
  'winetricks'
  'dxvk'
  'vulkan-icd-loader'
  'lib32-vulkan-icd-loader'
  'curl'
  'jq'
  'cabextract'
  'unzip'
  'p7zip'
)
makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-wheel'
  'python-uv-build'
)
optdepends=(
  'nvidia-utils: NVIDIA Vulkan'
  'lib32-nvidia-utils: NVIDIA Vulkan (32-bit)'
  'vulkan-radeon: AMD Vulkan'
  'lib32-vulkan-radeon: AMD Vulkan (32-bit)'
  'vulkan-intel: Intel Vulkan'
  'lib32-vulkan-intel: Intel Vulkan (32-bit)'
  'gamemode: performance daemon'
  'lib32-gamemode: performance daemon (32-bit)'
  'mangohud: FPS overlay'
  'lib32-mangohud: FPS overlay (32-bit)'
  'vkd3d-proton: DirectX 12 support'
)
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  git describe --tags --long 2>/dev/null | sed 's/^v//;s/-.*//' || echo "$pkgver"
}

build() {
  cd "$srcdir/$pkgname"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 assets/zapusk.desktop "$pkgdir/usr/share/applications/zapusk.desktop"
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/zapusk.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
